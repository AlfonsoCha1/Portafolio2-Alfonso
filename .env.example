# URL pública del sitio (para metadatos, sitemap y Open Graph)
NEXT_PUBLIC_SITE_URL=https://portafolio2-alfonso.vercel.app

# Formulario de contacto — servicio de envío (Resend: https://resend.com)
# Sin estas variables el formulario NO envía nada y lo dice claramente.
RESEND_API_KEY=
# Remitente verificado en Resend (por ejemplo: "Portafolio <contacto@tudominio.com>")
CONTACT_FROM_EMAIL=
# Correo donde quieres recibir los mensajes
CONTACT_TO_EMAIL=alfonso.chavarin@hotmail.com
